NODE_ENV=development
PORT=10006
APP_URL=http://localhost:10006

# Hozircha ochiq — frontchi localda ishlashi uchun.
# Keyin: CORS_ORIGIN=https://auronlub.com,https://www.auronlub.com
CORS_ORIGIN=*

DB_HOST=localhost
