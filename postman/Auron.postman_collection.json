{
  "info": {
    "_postman_id": "auron-backend-collection",
    "name": "Auron Backend",
    "description": "Auron (auronlub.com) to'liq API. Login qilgach token avtomatik saqlanadi. Category/product create dan keyin id lar ham yoziladi.\n\n1. Environment: Auron Local ni tanlang.\n2. Auth → Login ni ishga tushiring.\n3. Qolgan protected so'rovlar Bearer {{token}} bilan ketadi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:10006"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) {",
                  "    pm.environment.set('token', json.accessToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Superadmin login. Javobdagi accessToken environmentga yoziladi."
          }
        },
        {
          "name": "Update superadmin",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"username\": \"admin\",\n  \"newPassword\": \"admin1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/update",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "update"]
            },
            "description": "Username va/yoki parolni o'zgartirish. currentPassword majburiy."
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get all categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Barcha kategoriyalar va ichidagi productlar. Public."
          }
        },
        {
          "name": "Get category by id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "description": "Bitta kategoriya + productlar. Public."
          }
        },
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.environment.set('categoryId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title_en", "value": "Engine oils", "type": "text" },
                { "key": "title_ru", "value": "Моторные масла", "type": "text" },
                { "key": "sortOrder", "value": "1", "type": "text" },
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Kamida 1 ta rasm. Bir nechta ham bo'lishi mumkin (jpg, jpeg, png, webp, gif)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "multipart/form-data. images majburiy. Token kerak."
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title_en", "value": "Engine oils", "type": "text" },
                { "key": "title_ru", "value": "Моторные масла", "type": "text" },
                { "key": "sortOrder", "value": "1", "type": "text" },
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Yangi rasm yuborilsa eski rasmlar o'chadi."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "description": "PATCH. Rasm ixtiyoriy. Token kerak."
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            },
            "description": "Kategoriya va uning rasmlari o'chadi. Ichida product bo'lsa RESTRICT."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get all products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Barcha productlar. Public."
          }
        },
        {
          "name": "Get products by category",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}" }
              ]
            },
            "description": "Filter: categoryId. Ixtiyoriy: volume=1L"
          }
        },
        {
          "name": "Get products by volume",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?volume=1L",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "volume", "value": "1L" }
              ]
            }
          }
        },
        {
          "name": "Search products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/search?name=5W-40&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "name", "value": "5W-40" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "name majburiy. limit 1-20, default 10. Public."
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Bitta product + category. Public."
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.environment.set('productId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name_en", "value": "Auron 5W-40", "type": "text" },
                { "key": "name_ru", "value": "Auron 5W-40", "type": "text" },
                { "key": "description_en", "value": "Synthetic engine oil for passenger cars.", "type": "text" },
                { "key": "description_ru", "value": "Синтетическое моторное масло для легковых автомобилей.", "type": "text" },
                { "key": "volumes", "value": "1L,4L,5L,20L", "type": "text" },
                { "key": "viscosityClass", "value": "5W-40", "type": "text" },
                { "key": "densityAt15C", "value": "0.855", "type": "text" },
                { "key": "kinematicViscosityAt40C", "value": "84.5", "type": "text" },
                { "key": "kinematicViscosityAt100C", "value": "14.2", "type": "text" },
                { "key": "viscosityIndex", "value": "170", "type": "text" },
                { "key": "flashPoint", "value": "230", "type": "text" },
                { "key": "pourPoint", "value": "-39", "type": "text" },
                { "key": "baseNumber", "value": "10.5", "type": "text" },
                { "key": "specifications", "value": "API SN,ACEA A3/B4", "type": "text" },
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "sortOrder", "value": "1", "type": "text" },
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Kamida 1 ta rasm."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "multipart/form-data. images va name_en/name_ru, categoryId majburiy. Texnik maydonlar vergul yoki JSON array."
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name_en", "value": "Auron 5W-40", "type": "text" },
                { "key": "name_ru", "value": "Auron 5W-40", "type": "text" },
                { "key": "description_en", "value": "Updated description", "type": "text" },
                { "key": "description_ru", "value": "Обновлённое описание", "type": "text" },
                { "key": "volumes", "value": "1L,4L,5L", "type": "text" },
                { "key": "viscosityClass", "value": "5W-40", "type": "text" },
                { "key": "specifications", "value": "[\"API SN\",\"ACEA A3/B4\"]", "type": "text" },
                { "key": "categoryId", "value": "{{categoryId}}", "type": "text" },
                { "key": "sortOrder", "value": "2", "type": "text" },
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Yangi rasm yuborilsa eski rasmlar o'chadi."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "PATCH. Rasm ixtiyoriy. Token kerak."
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Product va rasmlari diskdan o'chadi."
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Send message",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"phone\": \"+998901234567\",\n  \"email\": \"john@example.com\",\n  \"message\": \"Need distributor information.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact",
              "host": ["{{baseUrl}}"],
              "path": ["contact"]
            },
            "description": "Public. Xabar info@auronlub.com ga ketadi. email ixtiyoriy."
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/upload",
              "host": ["{{baseUrl}}"],
              "path": ["upload"]
            },
            "description": "uploads/files ichidagi PDF/Word ro'yxati. Token kerak."
          }
        },
        {
          "name": "Upload file",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.url) {",
                  "    const parts = String(json.url).split('/');",
                  "    pm.environment.set('filename', parts[parts.length - 1]);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "PDF, DOC yoki DOCX. Max 100MB."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload",
              "host": ["{{baseUrl}}"],
              "path": ["upload"]
            },
            "description": "Katalog PDF va hujjatlar. Token kerak."
          }
        },
        {
          "name": "Stream file",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/upload/file/{{filename}}",
              "host": ["{{baseUrl}}"],
              "path": ["upload", "file", "{{filename}}"]
            },
            "description": "Public. PDF inline ochiladi."
          }
        },
        {
          "name": "Delete file",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/upload/{{filename}}",
              "host": ["{{baseUrl}}"],
              "path": ["upload", "{{filename}}"]
            },
            "description": "Faylni uploads/files dan o'chiradi. Token kerak."
          }
        }
      ]
    }
  ]
}
